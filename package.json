{
  "name": "skillnest-student-portfolio",
  "version": "1.0.0",
  "description": "SkillNest – Student Portfolio & Skill-Sharing Platform for University Students",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:reset": "node server/database/reset.js"
  },
  "keywords": [
    "student-portfolio",
    "skill-sharing",
    "team-finder",
    "react",
    "express",
    "sqlite"
  ],
  "author": "SkillNest Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
